# Enforce LF line endings for all text files
# This prevents CRLF issues when files are edited on Windows
* text=auto eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.tpl   text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.go    text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
