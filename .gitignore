# =============================================================================
# .gitignore — SkillPulse project
# Covers: Go, Node/JS, Docker, Kubernetes, Terraform, Ansible, GitHub Actions
# =============================================================================

# =============================================================================
# SECRETS & CREDENTIALS — never commit these
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secrets.yml
secrets.yaml
*secrets*
*credentials*
ansible-vault-password
vault-password.txt

# =============================================================================
# GO — backend
# =============================================================================
# Compiled binaries
backend/skillpulse
backend/*.exe
backend/*.out
backend/*.test

# Go test cache and coverage
*.cover
*.coverprofile
coverage.out
coverage.html

# Go build cache (local — not needed in repo)
/tmp/

# Dependency vendor directory (if not vendoring)
# vendor/

# Go workspace files (Go 1.18+)
go.work
go.work.sum

# =============================================================================
# TERRAFORM
# =============================================================================
# Local tfstate — contains sensitive infra details
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.backup

# tfvars contains your real IPs, keys, secrets
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Terraform working directory
**/.terraform/
.terraform/
.terraform.lock.hcl

# Terraform plan output files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =============================================================================
# ANSIBLE
# =============================================================================
# hosts.ini is auto-generated by Terraform — do not commit
ansible/hosts.ini
hosts.ini
inventory.ini

# Ansible retry files
*.retry

# Ansible vault encrypted files (keep encrypted ones, ignore unencrypted)
# If you use ansible-vault, encrypted files are safe to commit
# Unencrypted vault files should never be committed
*vault-plaintext*

# Ansible Galaxy roles downloaded locally
ansible/roles/
roles/

# =============================================================================
# DOCKER
# =============================================================================
# Docker build context temp files
.dockerignore.bak

# Docker Compose override (local developer overrides)
docker-compose.override.yml
docker-compose.local.yml

# Local .env used by docker-compose
.env.local
.env.production

# =============================================================================
# KUBERNETES
# =============================================================================
# kubeconfig — contains cluster credentials
kubeconfig
*.kubeconfig
.kube/
kube-config

# kind cluster config with sensitive data
# (kind-config.yaml itself is safe to commit — no secrets in it)

# Helm chart dependencies downloaded locally
charts/
*.tgz

# =============================================================================
# GITHUB ACTIONS
# =============================================================================
# Local act runner temp files (if using nektos/act for local testing)
.actrc
.act/

# =============================================================================
# OS FILES
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# EDITORS & IDEs
# =============================================================================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (GoLand, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# =============================================================================
# LOGS & TEMP FILES
# =============================================================================
*.log
*.logs
logs/
log/
tmp/
temp/
.tmp/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.cache

# =============================================================================
# BUILD ARTIFACTS
# =============================================================================
dist/
build/
bin/
out/
target/

# =============================================================================
# NODE / JAVASCRIPT (frontend tooling if added later)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/cache
.pnp.*
.next/
.nuxt/
.cache/
